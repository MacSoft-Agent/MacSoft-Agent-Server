# ============================================================
# Generated packaging and release artifacts
# ============================================================
staging/
release/
backup/
work/

# ============================================================
# Hermes / Electron generated dependencies and builds
# ============================================================
hermes/node_modules/
hermes/apps/desktop/release/
hermes/apps/desktop/coverage/
# TypeScript is the Hermes app source of truth. Never commit JavaScript emitted
# beside src/*.ts or src/*.tsx.
hermes/apps/*/src/**/*.js

# ============================================================
# Python generated files
# ============================================================
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# ============================================================
# JavaScript generated files
# ============================================================
**/node_modules/
**/.vite/
**/coverage/

# ============================================================
# Local probes and captured development evidence
# ============================================================
docs/hermes-bridge-probe.txt
server/autocount-api-result.txt
server/macsoft-hermes-bridge-input.txt

# ============================================================
# Runtime data and databases
# ============================================================
runtime/
# Protected Skill source is authored in Packaging and deployed into the
# generated runtime by protected-resources directory synchronization.
!packaging/templates/protected/runtime/
!packaging/templates/protected/runtime/skills/
!packaging/templates/protected/runtime/skills/**
server/data/
server/initialization.json
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# ============================================================
# Secrets and local environment
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# ============================================================
# Editors and Windows
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
