server:
  host: "127.0.0.1"
  port: 8787

database:
  path: "./data/macsoft-server.db"

hermes:
  home: "../hermes"
  api_base_url: "http://127.0.0.1:8642"
  api_key: "replace-with-local-gateway-key"
  request_timeout_seconds: 600

models:
  default_model: "server-default"
  fallback_model: "server-fallback"

runtime:
  mode: "minimal"

autocount:
  enabled: false
  catalog_path: "./docs/autocount-api-catalog.json"
  plugin_config_path: "../runtime/plugins/macsoft-autocount/config.json"

# Server Foundation only. Keep disabled in production until the Hermes,
# AutoCount, Connector, financial-rule, and Client gates are approved.
chart_artifacts:
  enabled: false
  environment: "production"
  storage_path: "./data/chart-artifacts"
  worker_max_attempts: 3
  lease_seconds: 30
  render_input_ttl_minutes: 60
  retention_days: 30
  renderer_backend: "foundation" # Use "chromium" after installed-product acceptance.
  chromium_path: ""
